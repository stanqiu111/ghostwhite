# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# ── Django core ──────────────────────────────────────────────────────────────
# Required. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# 1 for local development. Explicitly set 0 in production.
DJANGO_DEBUG=1

# Comma-separated hostnames. Required when DJANGO_DEBUG is not 1.
# e.g. DJANGO_ALLOWED_HOSTS=myapp.herokuapp.com,www.myapp.com
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# ── Database ─────────────────────────────────────────────────────────────────
# Postgres connection string. Leave unset to use the local SQLite file.
# e.g. DATABASE_URL=postgres://user:password@host:5432/dbname
DATABASE_URL=

# ── Email (verification links) ───────────────────────────────────────────────
# Console backend prints verification links to the development terminal.
# In production use: django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Base URL used to build verification links in outgoing email.
FRONTEND_URL=http://localhost:8000

# ── Logging ──────────────────────────────────────────────────────────────────
DJANGO_LOG_LEVEL=INFO
AUTHORS_LOG_LEVEL=INFO

# Optional cross-network streaming; see docs/FEDERATED_STREAMING.md.
# STREAM_ICE_SERVERS_JSON='[{"urls":"stun:stun.example.net:3478"}]'
# STREAM_TURN_URLS=turn:turn.example.net:3478,turns:turn.example.net:5349
# STREAM_TURN_SHARED_SECRET=
