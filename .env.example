# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# ── Django core ──────────────────────────────────────────────────────────────
# Required. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# 1 for local development, 0 (or unset) in production.
DJANGO_DEBUG=1

# Comma-separated hostnames. Required when DJANGO_DEBUG is not 1.
# e.g. DJANGO_ALLOWED_HOSTS=myapp.herokuapp.com,www.myapp.com
DJANGO_ALLOWED_HOSTS=

# ── Database ─────────────────────────────────────────────────────────────────
# Postgres connection string. Leave unset to use the local SQLite file.
# e.g. DATABASE_URL=postgres://user:password@host:5432/dbname
DATABASE_URL=

# ── Email (verification links) ───────────────────────────────────────────────
# Leave EMAIL_BACKEND unset in development — emails print to the console.
# In production use: django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Base URL used to build verification links in outgoing email.
FRONTEND_URL=http://localhost:8000

# ── Logging ──────────────────────────────────────────────────────────────────
DJANGO_LOG_LEVEL=INFO
AUTHORS_LOG_LEVEL=INFO
